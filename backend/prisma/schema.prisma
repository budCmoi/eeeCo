generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum OrderStatus {
  processing
  paid
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum ProductStatus {
  active
  draft
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  firstName      String          @default("")
  lastName       String          @default("")
  name           String
  email          String          @unique
  password       String?
  googleId       String?         @unique
  avatar         String?
  phone          String?
  role           UserRole        @default(user)
  addresses      Address[]
  paymentMethods PaymentMethod[]
  orders         Order[]
  product        Product?        @relation("OwnerProduct")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([email])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Principale")
  firstName  String
  lastName   String
  street     String
  city       String
  postalCode String
  country    String   @default("France")
  isDefault  Boolean  @default(false)
  isBilling  Boolean  @default(false)
  isShipping Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model PaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  label     String
  brand     String?
  last4     String?
  expMonth  Int?
  expYear   Int?
  isDefault Boolean  @default(false)
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  title            String
  shortDescription String
  longDescription  String        @db.Text
  price            Float
  compareAtPrice   Float?
  stock            Int           @default(0)
  mainImage        String
  images           ProductImage[]
  features         String[]
  benefits         String[]
  specifications   Json          @default("{}")
  marketingText    String?       @db.Text
  status           ProductStatus @default(draft)
  isActive         Boolean       @default(false)
  ownerId          String?       @unique @db.Uuid
  owner            User?         @relation("OwnerProduct", fields: [ownerId], references: [id])
  orderItems       OrderItem[]
  reviews          Review[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  src       String
  alt       String?
  position  Int      @default(0)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  avatar    String?
  rating    Int
  comment   String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  address       Json
  subtotal      Float
  shipping      Float
  discount      Float         @default(0)
  total         Float
  promoCode     String?
  paymentMethod String        @default("demo")
  status        OrderStatus   @default(processing)
  paymentStatus PaymentStatus @default(pending)
  isDemo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@index([orderId])
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
